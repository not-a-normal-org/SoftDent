// NextDent web app — target schema, reverse-engineered from the legacy Access DB.
// See ../extraction/data-model.md for the Access→Postgres mapping and rationale.
// Migrated entities keep their legacy integer id as PK (autoincrement so new rows still work;
// ETL inserts explicit ids then bumps the sequence). New tables (history/search) use fresh ids.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; debian target for the Docker runtime (node:20-bookworm-slim)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a session (non-transaction-pooled) connection: a transaction
  // pooler rewrites connections under Prisma and breaks DDL and advisory locks.
  // Prisma errors if this is unset, so set it to the same value as DATABASE_URL
  // anywhere there is no separate pooler (local dev, docker-compose).
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── enums ───────────────────────────
enum Role {
  OWNER
  DOCTOR
  RECEPTIONIST
  ASSISTANT
}

enum HistoryKind {
  MEDICAL
  DRUG
  ALLERGY
}

// ─────────────────────── identity & security ───────────────────────
model Person {
  id             Int       @id @default(autoincrement())
  fullName       String
  nickName       String?
  primaryPhone   String?
  secondaryPhone String?
  address        String?
  email          String?
  dob            DateTime?
  gender         String?
  maritalStatus  String?
  nid            String?
  note           String?
  activeStatus   Boolean   @default(true)
  createdAt      DateTime  @default(now())

  user   User?
  doctor Doctor?
}

model User {
  id                 Int      @id @default(autoincrement())
  person             Person   @relation(fields: [personId], references: [id])
  personId           Int      @unique
  username           String   @unique
  passwordHash       String   @default("") // legacy VBA hash NOT migrated
  role               Role     @default(RECEPTIONIST)
  activeStatus       Boolean  @default(true)
  needsPasswordReset Boolean  @default(true)
  createdAt          DateTime @default(now())

  auditLogs AuditLog[]
  sessions  Session[]
  calendar  CalendarConnection?
}

// Per-user Google Calendar connection (each staff member links their own Google account).
model CalendarConnection {
  id           Int       @id @default(autoincrement())
  user         User      @relation(fields: [userId], references: [id])
  userId       Int       @unique
  googleEmail  String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  calendarId   String?   @default("primary")
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model Doctor {
  id                     Int     @id @default(autoincrement())
  person                 Person  @relation(fields: [personId], references: [id])
  personId               Int     @unique
  isOwner                Boolean @default(false)
  degree                 String?
  designation1           String?
  designation2           String?
  clinicName             String?
  institute              String?
  session                String?
  regNo                  String?
  activeStatus           String?
  labBillReductionMethod String?
  revenueShare           Json? // legacy owner/guest/OT/chamber % matrix (data-model §7.2)
  // Per-contract revenue split (admin-configurable). Chamber/clinic gets the remainder.
  consultantSharePct     Float   @default(20) // this doctor's cut when they are the consultant
  operatorSharePct       Float   @default(40) // this doctor's cut when they operate (OT)
  deductLabBeforeSplit   Boolean @default(true)
  note                   String?

  patients       Patient[]       @relation("ConsultantDoctor")
  appointments   Appointment[]
  treatmentLines TreatmentLine[] @relation("OperatingDoctor")
  prescriptions  Prescription[]
}

// ─────────────────────────── patients ───────────────────────────
model Patient {
  id                 Int       @id @default(autoincrement())
  fullName           String
  nickName           String?
  email              String?
  primaryPhone       String?
  phoneDigits        String? // normalized digits-only, for dash-insensitive search
  foreignPhone       String?
  since              DateTime?
  dob                DateTime?
  address            String?
  gender             String?
  maritalStatus      String?
  occupation         String?
  emergencyRelation  String?
  emergencyName      String?
  emergencyPhone     String?
  photoPath          String?
  photoUrl           String?
  lifetimeDiscount   Float     @default(0)
  medicalHistory     String?
  drugHistory        String?
  note               String?
  consultantDoctor   Doctor?   @relation("ConsultantDoctor", fields: [consultantDoctorId], references: [id])
  consultantDoctorId Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cases           TreatmentCase[]
  appointments    Appointment[]
  prescriptions   Prescription[]
  smsLogs         SmsLog[]
  clinicalNotes   ClinicalNote[]
  historyVersions PatientHistoryVersion[]
  toothEntries    ToothChartEntry[]
  attachments     Attachment[]
  recalls         Recall[]
  events          PatientEvent[]
  labOrders       LabOrder[]
  connections     PatientConnection[]     @relation("connFrom")
  connectedTo     PatientConnection[]     @relation("connTo")
  healthRecords   HealthRecord[]

  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([nickName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phoneDigits])
}

// ─────────────────────── treatment & billing ───────────────────────
model Treatment {
  id           Int    @id @default(autoincrement())
  name         String @unique
  defaultPrice Int    @default(0)

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model TreatmentCase {
  id          Int      @id @default(autoincrement())
  patient     Patient  @relation(fields: [patientId], references: [id])
  patientId   Int
  name        String?
  description String?
  status      String?
  notes       String?
  createdAt   DateTime @default(now())

  lines TreatmentLine[]
}

model TreatmentLine {
  id                  Int           @id @default(autoincrement())
  case                TreatmentCase @relation(fields: [caseId], references: [id])
  caseId              Int
  operatingDoctor     Doctor?       @relation("OperatingDoctor", fields: [operatingDoctorId], references: [id])
  operatingDoctorId   Int?
  treatmentDate       DateTime?
  treatmentName       String?
  description         String?
  totalAmount         Int           @default(0)
  discountPercent     Float         @default(0)
  afterDiscountAmount Int           @default(0)
  amountPaid          Int           @default(0)
  note                String?

  payments Payment[]
  teeth    TreatmentLineTooth[]
}

// NEW: proper payment ledger (legacy tracked only a running amountPaid on the line)
model Payment {
  id              Int           @id @default(autoincrement())
  treatmentLine   TreatmentLine @relation(fields: [treatmentLineId], references: [id])
  treatmentLineId Int
  amount          Int
  method          String?
  paidAt          DateTime      @default(now())
  note            String?
}

// ─────────────────────────── appointments ───────────────────────────
model Appointment {
  id              Int       @id @default(autoincrement())
  doctor          Doctor?   @relation(fields: [doctorId], references: [id])
  doctorId        Int?
  patient         Patient   @relation(fields: [patientId], references: [id])
  patientId       Int
  allocatedUnit   String?
  statusCode      Int? // legacy AppointmentStatusID — meaning TBD (data-model §7)
  status          String?
  appointmentDate DateTime?
  startsAt        DateTime?
  endsAt          DateTime?
  smsSent         Boolean   @default(false)
  note            String?
  gcalId          String?

  @@index([appointmentDate])
  @@index([patientId])
}

// ─────────────────────────── prescriptions ───────────────────────────
model Drug {
  id           Int       @id @default(autoincrement())
  manufacturer String?
  brandName    String?
  genericName  String?
  strength     String?
  dosageForm   String?
  // how often this drug has been picked in the Rx editor — ranks the type-ahead so a
  // doctor's regulars surface first. Backfilled from prescription history on migration.
  usageCount   Int       @default(0)
  lastUsedAt   DateTime?

  @@index([brandName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([genericName(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Prescription {
  id                          Int       @id @default(autoincrement())
  patient                     Patient?  @relation(fields: [patientId], references: [id])
  patientId                   Int?
  dentist                     Doctor?   @relation(fields: [dentistId], references: [id])
  dentistId                   Int?
  rxDate                      DateTime?
  complaints                  String?
  medicalHistory              String?
  drugHistory                 String?
  previousDentalHistory       String?
  findingsOnExamination       String?
  provisionalDiagnosis        String?
  differentialDiagnosis       String?
  investigationAdvised        String?
  investigationInterpretation String?
  confirmatoryDiagnosis       String?
  treatmentPlan               String?
  procedurePerformed          String?
  advise                      String?
  followUpDate                DateTime?
  followUpReason              String?
  randomName                  String?
  randomAge                   String?
  randomSex                   String?
  /// Free-text note on the prescription. The Barishal legacy database carries this as
  /// its own column; the Dhaka one had no equivalent, so it arrived with the import.
  note                        String?
  /// "en" or "bn" — which language the printed prescription's labels are set in.
  /// Null means the clinic default. The clinical text itself is whatever was typed.
  language                    String?
  deletedAt                   DateTime?
  deletedBy                   String?

  drugs PrescriptionDrug[]
}

model PrescriptionDrug {
  id             Int          @id @default(autoincrement())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  prescriptionId Int
  sortOrder      Int          @default(0)
  drug           String?
  dose           String? // Bengali dosing text
  meal           String?
  duration       String?
}

// reusable phrase library powering the fast Rx editor
model RxSnippet {
  id                          Int     @id @default(autoincrement())
  complaints                  String?
  medicalHistory              String?
  previousDentalHistory       String?
  diagnosis                   String?
  investigationAdvised        String?
  investigationInterpretation String?
  treatment                   String?
  adviseHeader                String?
  advise                      String?
  drugDoseSortOrder           Int?
  drugDose                    String?
  drugDurationSortOrder       Int?
  drugDuration                String?
  drugMealSortOrder           Int?
  drugMeal                    String?
  followUpReason              String?
}

model RxTemplate {
  id                    Int       @id @default(autoincrement())
  name                  String
  complaints            String?
  findingsOnExamination String?
  provisionalDiagnosis  String?
  differentialDiagnosis String?
  investigationAdvised  String?
  confirmatoryDiagnosis String?
  treatmentPlan         String?
  procedurePerformed    String?
  advise                String?
  followUpDay           Int?
  followUpReason        String?
  createdBy             String?
  createdAt             DateTime?
  editedBy              String?
  editedAt              DateTime?

  drugs RxTemplateDrug[]
}

model RxTemplateDrug {
  id         Int        @id @default(autoincrement())
  template   RxTemplate @relation(fields: [templateId], references: [id])
  templateId Int
  sortOrder  Int        @default(0)
  drug       String?
  dose       String?
  meal       String?
  duration   String?
}

// ─────────────────────── comms & config ───────────────────────
model SmsTemplate {
  id      Int     @id @default(autoincrement())
  name    String
  // Legacy Access shape: a heading plus up to six fragments that the old VBA
  // concatenated around runtime values ("Dear" + name + ", your due is BDT" + amount).
  // Kept as the English reference for the Bangla rewrite; `body` supersedes them.
  heading String?
  body1   String?
  body2   String?
  body3   String?
  body4   String?
  body5   String?
  body6   String?

  /// Stable identifier used in code and logs: CONFIRMED, REMINDED, PAYMENT_DUE, …
  key       String?  @unique
  /// The message actually sent, with {placeholders}. Must be Bangla — the gateway
  /// rejects English on a masked sender ID with code 1012.
  body      String?
  /// Appointment status this template is offered for. Only a hint for the UI: unlike
  /// the Access app, where AppointmentStatusID was a foreign key INTO this table and
  /// changing a status could fire a message, sending here is always explicit.
  statusKey String?
  active    Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([statusKey])
}

model IntegrationSetting {
  id                Int       @id @default(autoincrement())
  name              String
  accessToken       String?
  accessTokenExpire DateTime?
  refreshToken      String?
  clientId          String?
  clientSecret      String?
  // NOTE: secrets to be moved to a vault; rotate the leaked SMS key.
}

model ClinicSetting {
  id                      Int     @id @default(autoincrement())
  // "Body" prints the prescription only, for pre-printed letterhead stationery;
  // "Full" prints the clinic header/footer too. Carried over from the Access app,
  // where the clinic's default was already "Body".
  defaultRxType           String?
  bodyRxReportName        String?
  fullRxReportName        String?
  // Blank space (mm) reserved at the top/bottom of a "Body" print so the content
  // clears the letterhead already printed on the paper. Tunable per clinic because
  // every letterhead is a different height — measure the stationery and set these.
  rxBodyTopMm             Int     @default(45)
  rxBodyBottomMm          Int     @default(20)
  autoAddAppointment      Boolean @default(false)
  autoCompleteAppointment Boolean @default(false)
  // Configurable schedule (0=Sun … 6=Sat). Default mirrors the legacy "Sat–Wed" hours.
  workingDays             Int[]   @default([6, 0, 1, 2, 3])
  openTime                String  @default("15:00")
  closeTime               String  @default("19:00")
  slotMinutes             Int     @default(30)
}

model DocumentTemplate {
  id       Int     @id @default(autoincrement())
  docName  String
  heading1 String?
  heading2 String?
  heading3 String?
  heading4 String?
  heading5 String?
  heading6 String?
  heading7 String?
  heading8 String?
  heading9 String?
  footer   String?
}

model Lab {
  id                 Int       @id @default(autoincrement())
  name               String
  address            String?
  contactPerson      String?
  contactNumber      String?
  email              String?
  specialization     String?
  agreementStartDate DateTime?
  paymentTerms       String?
  isActive           Boolean   @default(true)
  notes              String?

  orders LabOrder[]
}

model LabOrder {
  id         Int       @id @default(autoincrement())
  patient    Patient   @relation(fields: [patientId], references: [id])
  patientId  Int
  lab        Lab       @relation(fields: [labId], references: [id])
  labId      Int
  workType   String? // Crown, Bridge, Denture…
  toothFdi   String?
  shade      String? // VITA shade from the LabShade lookup
  sentAt     DateTime?
  expectedAt DateTime?
  receivedAt DateTime?
  status     String    @default("SENT")
  cost       Int       @default(0)
  note       String?
  createdAt  DateTime  @default(now())

  @@index([patientId])
  @@index([status])
}

model Vendor {
  id            Int       @id @default(autoincrement())
  name          String
  businessPhone String?
  address       String?
  website       String?
  note          String?
  products      Product[]
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  category     String?
  unit         String? // box, piece, ml…
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  unitPrice    Int      @default(0)
  vendor       Vendor?  @relation(fields: [vendorId], references: [id])
  vendorId     Int?
  note         String?
  createdAt    DateTime @default(now())

  movements StockMovement[]
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  delta     Int // +received / -used
  reason    String?
  byId      Int?
  at        DateTime @default(now())

  @@index([productId])
}

// ─────────────────────── normalized lookups (from tbl_CommonInfo) ───────────────────────
model Occupation {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Relation {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model ConnectionRelation {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model AddressPreset {
  id    Int    @id @default(autoincrement())
  value String @unique
}

model ScheduleSlot {
  id    Int    @id @default(autoincrement())
  label String @unique
}

model CaseType {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model LabShade {
  id   Int    @id @default(autoincrement())
  code String @unique
}

model Unit {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model SalaryType {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model ProductCategory {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model ExpenseCategory {
  id   Int    @id @default(autoincrement())
  name String @unique
}

// ─────────────────────── patient history & search (NEW) ───────────────────────
model PatientConnection {
  id               Int      @id @default(autoincrement())
  patient          Patient  @relation("connFrom", fields: [patientId], references: [id])
  patientId        Int
  relatedPatient   Patient? @relation("connTo", fields: [relatedPatientId], references: [id])
  relatedPatientId Int?
  relatedName      String? // used when the relative isn't a registered patient
  relation         String? // Father, Spouse, Child…
  createdAt        DateTime @default(now())

  @@index([patientId])
}

model HealthRecord {
  id            Int      @id @default(autoincrement())
  patient       Patient  @relation(fields: [patientId], references: [id])
  patientId     Int
  recordedAt    DateTime @default(now())
  bloodPressure String?
  pulse         String?
  weightKg      String?
  bloodGroup    String?
  allergies     String?
  conditions    String?
  note          String?
  recordedById  Int?

  @@index([patientId])
}

model ClinicalNote {
  id        Int      @id @default(autoincrement())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId Int
  authorId  Int?
  body      String
  createdAt DateTime @default(now())

  @@index([patientId])
}

model PatientHistoryVersion {
  id        Int         @id @default(autoincrement())
  patient   Patient     @relation(fields: [patientId], references: [id])
  patientId Int
  kind      HistoryKind
  body      String?
  validFrom DateTime    @default(now())
  authorId  Int?

  @@index([patientId, kind])
}

model ToothChartEntry {
  id              Int      @id @default(autoincrement())
  patient         Patient  @relation(fields: [patientId], references: [id])
  patientId       Int
  toothFdi        String // FDI two-digit notation e.g. "14", "48"
  status          String?
  treatmentLineId Int?
  recordedAt      DateTime @default(now())

  @@index([patientId])
}

model TreatmentLineTooth {
  treatmentLine   TreatmentLine @relation(fields: [treatmentLineId], references: [id])
  treatmentLineId Int
  toothFdi        String

  @@id([treatmentLineId, toothFdi])
}

model Attachment {
  id         Int      @id @default(autoincrement())
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  Int
  caseId     Int?
  toothFdi   String?
  storageKey String
  kind       String? // photo | rvg | intraoral
  createdAt  DateTime @default(now())

  @@index([patientId])
}

model Recall {
  id        Int      @id @default(autoincrement())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId Int
  dueDate   DateTime
  reason    String?
  status    String   @default("pending")

  @@index([dueDate])
}

// denormalized timeline feed ("patient chart")
model PatientEvent {
  id         Int      @id @default(autoincrement())
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  Int
  eventType  String // appointment | treatment | payment | prescription | note | sms
  refId      Int?
  occurredAt DateTime
  summary    String?

  @@index([patientId, occurredAt])
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime
  category    String?
  description String?
  amount      Int
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([date])
}

// Income that is not a patient payment (owner re-investment, training fees) — the
// legacy tbl_RandomIncome, which Access kept beside its expense tables for the same
// reason this is a table of its own rather than a `kind` column on Expense: every
// expense query (monthly buckets, recent list, delete) would otherwise need a filter,
// and the one that forgets it books income as a cost. Category is a closed list, so
// unlike an expense it is never null — see lib/income-constants.ts.
model Income {
  id          Int      @id @default(autoincrement())
  date        DateTime
  category    String
  description String?
  amount      Int
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([date])
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  actor    User?    @relation(fields: [actorId], references: [id])
  actorId  Int?
  entity   String
  entityId String?
  action   String // create | update | delete
  diff     Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
}

// ─────────────────────── SMS (BulkSMS BD gateway) ───────────────────────

/// A message the clinic can send, with {placeholders} filled at send time.
/// Replaces the legacy `tbl_Sms`, whose rows were a heading plus six body fragments
/// that the Access front-end concatenated around values. Crucially, that table was
/// also the appointment *status* list (AppointmentStatusID was a FK into it), so
/// changing a status could fire an SMS as a side effect. Templates and statuses are
/// separate here: `statusKey` only says which status a template is *offered* for.

/// Every send attempt, successful or not. Gives staff a per-patient history and stops
/// the same reminder going out twice.
model SmsLog {
  id          Int      @id @default(autoincrement())
  patient     Patient? @relation(fields: [patientId], references: [id])
  patientId   Int?
  /// Stored as sent (88017…), since a patient's number may change later.
  phone       String
  body        String
  templateKey String?
  /// SENT when the gateway returned 202, FAILED otherwise.
  status      String
  /// Raw gateway response code — 202 success, 1007 insufficient balance, etc.
  gatewayCode String?
  error       String?
  /// Billable segments: Bangla is UCS-2, so 70 characters for one segment and 67
  /// each once concatenated — roughly double the cost of Latin text.
  segments    Int      @default(1)
  sentAt      DateTime @default(now())

  @@index([patientId])
  @@index([sentAt])
}
