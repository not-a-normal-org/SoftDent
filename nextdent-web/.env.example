# ── Database (required) ──
# Local dev:      postgresql://<user>@localhost:5432/nextdent?schema=public
# Docker compose: postgresql://nextdent:${POSTGRES_PASSWORD}@db:5432/nextdent?schema=public
# Managed (Neon/RDS/Supabase): use the provider's connection string (sslmode=require)
#
# DATABASE_URL is what the running app uses; DIRECT_URL is what `prisma migrate`
# uses. Both are required — Prisma fails to start if DIRECT_URL is missing.
# Where there is no pooler (local dev, docker-compose), set them to the same value.
#
# Supabase gives three strings under Connect. Use the pooler ones: the direct
# db.<ref>.supabase.co host resolves over IPv6 only unless you buy the IPv4 add-on.
#   DATABASE_URL -> Transaction pooler, port 6543, add ?pgbouncer=true
#   DIRECT_URL   -> Session pooler,     port 5432
# On a plain VM (no autoscaling) the session pooler is fine for both.
DATABASE_URL="postgresql://nextdent:changeme@db:5432/nextdent?schema=public"
DIRECT_URL="postgresql://nextdent:changeme@db:5432/nextdent?schema=public"

# Public base URL of the app (used for OAuth redirect URIs). No trailing slash.
APP_URL="http://localhost:3000"

# ── Clinic timezone ──
# The clinic is in Barishal, Bangladesh: UTC+6, no DST. Containers and Cloud Run
# default to UTC, which shifts every "today" and every month total by 6 hours.
# Dates on screen are always formatted in Asia/Dhaka (CLINIC_TZ in src/lib/format.ts)
# and the /finance month buckets are computed in it too, so this is belt-and-braces —
# but anything that still reads the host clock (logs, cron, `new Date()` defaults)
# needs it. Leave it as Asia/Dhaka unless the clinic moves.
TZ="Asia/Dhaka"

# ── docker-compose only ──
POSTGRES_PASSWORD="changeme"

# ── Google Calendar (optional — leave blank to keep the feature gated) ──
# One OAuth 2.0 Web client from Google Cloud Console; each user then connects their own account.
# Authorized redirect URI: ${APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Object storage for patient/case photos & imaging (reserved — upload UI is future work) ──
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── SMS via BulkSMS BD ──
# Leave BULKSMS_API_KEY empty to keep sending disabled; templates stay editable.
# Sender ID is masked, so every message MUST be Bangla — the gateway returns 1012
# ("Masking SMS must be sent in Bengali") for English content.
# If the account enforces IP allowlisting (code 1032) this cannot work from Cloud Run,
# whose egress IPs are dynamic; it would need a VPC connector + Cloud NAT static IP.
BULKSMS_API_KEY=""
BULKSMS_SENDER_ID="NextDent"
